generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id           String        @id
  name         String
  transactionType String
  color        String
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  description String
  amountCents Int
  type        String
  date        DateTime
  createdAt   DateTime @default(now())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([type, date])
  @@index([categoryId])
}